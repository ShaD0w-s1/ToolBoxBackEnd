# Local Django settings are safe by default and require no environment file.
# Add future service credentials here as names only; never commit real values.
DJANGO_SECRET_KEY=replace-me-in-deployed-environments
DJANGO_PRODUCTION_SECRET_KEY=

# CloudBase NoSQL HTTP API (server-side only)
CLOUDBASE_ENV_ID=da-tool-list-d2g0awsejc0658949
CLOUDBASE_API_KEY=replace-with-a-server-api-key
CLOUDBASE_NOSQL_INSTANCE=(default)
CLOUDBASE_NOSQL_DATABASE=(default)
